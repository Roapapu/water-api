meta {
  name: 04 Rechazar reporte sin foto
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/reports
  body: multipartForm
  auth: none
}

body:multipart-form {
  title: Este reporte no debe guardarse
  location: Calle de prueba
  description: Solicitud sin archivo para demostrar la validacion obligatoria.
  severity: HIGH
  phone: 5551234567
}

tests {
  test("Sin photo: 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().statusCode).to.equal(400);
  });
}
